<%- include('../../views/partials/pagehead') %>
<%- include('../../views/layout/customerNavBar') %>
<%- include('../../views/partials/breadcrumbs') %>
    

<div id="main-wrapper">
    <div class="site-wrapper-reveal border-bottom">
        <!-- Terms and Conditions Area Start -->
        <div class="terms-wrapper section-space--ptb_120">
            <div class="container">

                <div class="row">
                    <div class="col-lg-12 col-md-12">
                        <div class="shop-toolbar__items shop-toolbar__item--left">
                            <div class="shop-toolbar__item shop-toolbar__item--title">
                                <h1>Terms and Conditions</h1>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="terms-content-wrapper">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="terms-section mb-20">
                                <h5>1. Acceptance of Terms</h5>
                                <p>By accessing or using <%= companyName %>, you agree to comply with and be bound by these terms and conditions. If you do not agree to these terms, you must not use our website or services.</p>
                            </div>
                            <div class="terms-section mb-20">
                                <h5>2. Use of the Website</h5>
                                <ul>
                                    <li>You must be at least <%= minimumUserAge %> years old to use our website.</li>
                                    <li>You agree not to use the site for any unlawful or prohibited purpose.</li>
                                    <li>We reserve the right to terminate access to users who violate these terms.</li>
                                </ul>
                            </div>
                            <div class="terms-section mb-20">
                                <h5>3. Account Registration</h5>
                                <ul>
                                    <li>To sell books, you must create an account with accurate and complete information.</li>
                                    <li>You are responsible for maintaining the confidentiality of your account credentials.</li>
                                    <li>We reserve the right to suspend or terminate accounts that are misused.</li>
                                </ul>
                            </div>
                            <div class="terms-section mb-20">
                                <h5>4. Transactions</h5>
                                <ul>
                                    <li><%= companyName %> acts as a platform connecting buyers and sellers and does not guarantee the condition of items.</li>
                                    <li>All sales are final unless otherwise stated in our <a href="/policy">Refund Policy</a>.</li>
                                    <li>We reserve the right to cancel transactions suspected of fraud or abuse.</li>
                                </ul>
                            </div>
                            <div class="terms-section mb-20">
                                <h5>5. Intellectual Property</h5>
                                <p>All content on this site, including text, images, and logos, is the property of <%= companyName %> or its licensors and may not be used without permission.</p>
                            </div>
                            <div class="terms-section mb-20">
                                <h5>6. Liability</h5>
                                <p><%= companyName %> is not liable for any damages arising from the use of our platform, including loss of data, revenue, or profits.</p>
                            </div>
                            <div class="terms-section mb-20">
                                <h5>7. Modifications to Terms</h5>
                                <p>We reserve the right to modify these terms at any time. Changes will be posted on this page with an updated effective date. Continued use of our platform after changes indicates your acceptance of the revised terms.</p>
                            </div>
                            <div class="terms-section mb-20">
                                <h5>8. Governing Law</h5>
                                <p>These terms are governed by the laws of <%= companyJurisdiction %>. Any disputes arising will be subject to the exclusive jurisdiction of the courts in <%= companyJurisdiction %>.</p>
                            </div>
                            <div class="terms-section mb-20">
                                <h5>9. Contact Us</h5>
                                <p>If you have any questions about these terms, contact us at:</p>
                                <ul>
                                    <li>Email: <%= customerBusinessEmail %></li>
                                                                       
                                    <script>
                                        document.addEventListener('DOMContentLoaded', function() {
                                            function revealPhoneNumberTermsAndConditionPage(){
                                                let phoneNumberTag = document.querySelector('#listTagPhoneNumber')
                                                
                                                
                                                phoneNumberTag.innerHTML = '<i class="icon_phone"></i>: <%= companyPhoneNumber %>';
                                                
                                            }
                                            document.querySelector('#listTagPhoneNumber').addEventListener('click',revealPhoneNumberTermsAndConditionPage) ;
                                            document.querySelector('#listTagPhoneNumber').addEventListener('mouseover',revealPhoneNumberTermsAndConditionPage) ;
                                        });
                                    </script>
                                    <li id="listTagPhoneNumber"><i class="icon_phone"></i>click or hover to reveal phone number</li>
                                    <li>Address: <%= companyAddress %></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>
        <!-- Terms and Conditions Area End -->
    </div>

    <%- include('../../views/partials/footerarea') %>
</div>



</body>
</html>

