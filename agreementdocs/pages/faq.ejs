<%- include('../../views/partials/pagehead') %>
<%- include('../../views/partials/commonjslibs'); %>
<%- include('../../views/layout/customerNavBar') %>
<%- include('../../views/partials/breadcrumbs') %>



<div id="main-wrapper">
    <div class="site-wrapper-reveal border-bottom">
        <div class="faq-wrapper section-space--ptb_120">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 col-md-12">
                        <div class="shop-toolbar__items shop-toolbar__item--left">
                            <div class="shop-toolbar__item shop-toolbar__item--title">
                                <h1>Frequently Asked Questions</h1>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <!-- Book Condition Questions -->
                        <div class="faq-section mb-20">
                            <h5>Book Conditions and Grading</h5>
                            <div class="accordion" id="conditionAccordion">
                               
                                <div class="card">
                                    <div class="card-header" id="headingOne">
                                        <h2 class="mb-0">
                                            <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#bookConditionCollapse" aria-controls="bookConditionCollapse">
                                                How do you grade the condition of used books?
                                            </button>
                                        </h2>
                                    </div>
                                    <div id="bookConditionCollapse" class="collapse show" data-parent="#conditionAccordion">
                                        <div class="card-body">
                                            At <%= companyName %>, we use the following grading system:
                                            <ul>
                                                <!-- 'New','Like New','Good','Fair','Poor' -->
                                                <li><strong>New:</strong> Brand new, never used</li>
                                                <li><strong>Like New:</strong> Appears unread with no visible wear</li>
                                                <li><strong>Good:</strong> Average wear, all pages present</li>
                                                <li><strong>Fair:</strong> Noticeable wear, may have writing/highlighting</li>
                                                <li><strong>Poor:</strong> Significant wear, may have missing pages or damage</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Shipping Questions -->
                        <div class="faq-section mb-20">
                            <h5>Shipping and Delivery</h5>
                            <div class="accordion" id="shippingAccordion">
                                <div class="card">
                                    <div class="card-header" id="headingTwo">
                                        <h2 class="mb-0">
                                            <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#shippingConditionCollapse" aria-controls="shippingConditionCollapse">
                                                How long will it take to receive my books?
                                            </button>
                                        </h2>
                                    </div>
                                    <div id="shippingConditionCollapse" class="collapse show" data-parent="#shippingAccordion">
                                        <div class="card-body">
                                            Shipping times vary by seller and location. Generally:
                                            <ul>
                                                <li>Standard shipping: 5-7 business days</li>
                                                <li>Express shipping: 2-3 business days</li>
                                                <li>International shipping: 10-14 business days</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Returns Questions -->
                        <div class="faq-section mb-20">
                            <h5>Returns and Refunds</h5>
                            <div class="accordion" id="returnsAccordion">
                                <div class="card">
                                    <div class="card-header" id="headingThree">
                                        <h2 class="mb-0">
                                            <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#returnPolicyConditionCollapse" aria-controls="returnPolicyConditionCollapse">
                                                What is your return policy?
                                            </button>
                                        </h2>
                                    </div>
                                    <div id="returnPolicyConditionCollapse" class="collapse show" data-parent="#returnsAccordion">
                                        <div class="card-body">
                                            We accept returns within 30 days if:
                                            <ul>
                                                <li>The book's condition was misrepresented</li>
                                                <li>You received the wrong book</li>
                                                <li>The book has significant damage not noted in the listing</li>
                                            </ul>
                                            See our <a href="/policy">Return Policy</a> for complete details.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing Questions -->
                        <div class="faq-section mb-20">
                            <h5>Pricing and Payment</h5>
                            <div class="accordion" id="pricingAccordion">
                                <div class="card">
                                    <div class="card-header" id="headingFour">
                                        <h2 class="mb-0">
                                            <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#acceptedPaymentMethodsCollapse">
                                                What payment methods do you accept?
                                            </button>
                                        </h2>
                                    </div>
                                    <div id="acceptedPaymentMethodsCollapse" class="collapse show" data-parent="#pricingAccordion">
                                        <div class="card-body">
                                            We accept:
                                            <ul>
                                                <li>Major credit/debit cards (Visa, Mastercard, American Express)</li>
                                                <li>PayPal</li>
                                                <li>Bank transfers</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Contact Section -->
                        <div class="faq-section mb-20">
                            <h5>Still Have Questions?</h5>
                            <p>We're here to help! Contact our customer support team:</p>
                            <%- include('../../views/partials/small_contact_info') %>
                        </div>
                    </div>
                </div>                
            </div>
        </div>
        <%- include('../../views/partials/newsletterform') %>
    </div>

    <%- include('../../views/partials/footerarea') %>
</div>

<!--====================  scroll top ====================-->
<a href="#" class="scroll-top" id="scroll-top">
    <i class="arrow-top icon-arrow-up"></i>
    <i class="arrow-bottom icon-arrow-up"></i>
</a>