<div class="footer-area-wrapper">
    <div class="footer-area section-space--ptb_120">
        <div class="container">
            <div class="row footer-widget-wrapper">
                <div class="col-lg-4 col-md-4 col-sm-6 footer-widget">
                    <h6 class="footer-widget__title mb-20">Address</h6>
                    <ul class="footer-widget__list">
                        
                        <% // I do not want bots to automaticaly call website number. I want number to be revealed when clicked upon %>
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                function revealPhoneNumber(){
                                    let phoneNumberTag = document.querySelector('#anchorPhoneNumberLink')
                                    let allKeys = Object.keys(this);
                                    //console.log(`this keys: ${JSON.stringify(allKeys)}`);
                                    phoneNumberTag.href = 'tel:' + '<%= companyPhoneNumber %>';
                                    phoneNumberTag.innerHTML = '<%= companyPhoneNumber %>';
                                    
                                }
                                document.querySelector('#anchorPhoneNumberLink').addEventListener('click',revealPhoneNumber) ;
                                document.querySelector('#anchorPhoneNumberLink').addEventListener('mouseover',revealPhoneNumber) ;
                                let footerEmailTag = document.querySelector('#customerFooterAnchorEmailLink')
                                function revealEmailInCustomerFooter(){
                                    
                                    footerEmailTag.href = 'mailto:' + '<%= customerBusinessEmail %>';
                                    footerEmailTag.innerHTML = '<%= customerBusinessEmail %>';
                                } ;
                                footerEmailTag.addEventListener('click',revealEmailInCustomerFooter) ;
                                footerEmailTag.addEventListener('mouseover',revealEmailInCustomerFooter) ;
                            });
                        </script>
                      
                        
                        <li> 
                            <i class="icon_phone"></i>
                            <a href="#" class="hover-style-link" id="anchorPhoneNumberLink">Call Us</a>
                        </li>
                        <li> 
                            <i class="icon_mail"></i>
                            <a href="#" id='customerFooterAnchorEmailLink' class="hover-style-link">Email Us</a>
                        </li>
                        <li>
                            <i class="icon_pin"></i>
                            <%= companyName %>&nbsp;
                            <%= companyCity %>&nbsp; 
                            <%= companyState %>, 
                            <%= companyZip %>
                        </li>

                    </ul>
