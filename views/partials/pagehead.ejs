<!DOCTYPE html>
<html class="no-js" lang="zxx">
<% 
    var thisPageTitle = companyName ;
    if (typeof pagetitle != "undefined")
        thisPageTitle = pagetitle + " | " + companyName;
%>
<head>
    <meta charset="utf-8">
    <meta name="language" content="en-US" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title><%= thisPageTitle %></title>
    
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <!-- Favicon -->
    <link rel="icon" href="/assets/images/logo_dot_com/img_files/hockshi-favicon-color.svg">
    <meta name="description" content="<%= thisPageTitle%>">
   	<% if (typeof customBookSeo != 'undefined') {  %>
        
    <meta property="og:title" content="<%= customBookSeo.seoTitle %>" />
    <meta property="og:description" content="<%= customBookSeo.description %>" />
    <meta property="og:image" content="<%= customBookSeo.image_url %>" />
    <meta property="og:url" content="<%= customBookSeo.author %>" />
    <meta property="og:type" content="book" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= customBookSeo.seoTitle %>" />
    <meta name="twitter:description" content="<%= customBookSeo.description %>" />
    <meta name="twitter:image" content="<%= customBookSeo.image_url %>" />
    <meta name="twitter:url" content="<%= customBookSeo.fullUrl %>" />
    
    <link rel="canonical" href="<%= customBookSeo.fullUrl %>" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="<%= customBookSeo.author %>" />

    <% } else { %>
    <% // This is the default seo for the home page %>
    <meta property="og:title" content="<%= thisPageTitle %>" />
    
	<meta name="author" content="<%= companyName %>">
    <meta name="description" content="Explore our curated selection of used books on personal development, finances, business, computer technology, and science & math. Affordable, high-quality reads to inspire and educate. Start exploring today!">
	<meta property="og:site_name" content="<%= companyName %>" />
    <meta property="og:description" content="Explore our curated selection of used books on personal development, finances, business, computer technology, and science & math. Affordable, high-quality reads to inspire and educate. Start exploring today!">
	<meta property="og:determiner" content="The" />
	<meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="<%= websiteUrl %>/assets/images/logo_dot_com/img_files/new/svg/logo-color.svg" />
	<meta property="og:url" content="<%= websiteUrl %>">
	
    <% // twitter seo %>
    
    <meta property="twitter:description" content="Explore our curated selection of used books on personal development, finances, business, computer technology, and science & math. Affordable, high-quality reads to inspire and educate. Start exploring today!">
    <meta property="twitter:image" content="<%= websiteUrl %>/assets/images/logo_dot_com/img_files/new/svg/logo-color.svg">
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@<%= companyName %>" />
    <meta name="twitter:title" content="@<%= thisPageTitle %>" />
    <meta name="twitter:url" content="<%= websiteUrl %>" />
    <meta name="robots" content="index, follow">

	<link rel="canonical" href="<%= websiteUrl %>">

    <%  } %>
    
    <% /* Below is the default css */ %>

    <%- include('./defaultcommoncss') %>
    
    
    <%- include('./stylegraycss') %>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    
</head>

<body class="" id="body">