<style>
@import url('https://fonts.googleapis.com/css?family=Roboto:300,400');

body {
  font-family: 'Roboto', sans-serif;
  background-color: #f5f5f5;
  margin: 0;
  padding: 20px;
}

.cart-item {
  display: flex;
  padding: 20px;
  background: #fff;
  margin-bottom: 10px;
  border-radius: 5px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.image {
  width: 100px;
  height: 150px;
  margin-right: 20px;
  background-color: #e5e5e5;
}

.content {
  flex: 1;
}

.title,
.author,
.price,
.quantity,
.status {
  height: 20px;
  margin-bottom: 10px;
  background-color: #e5e5e5;
}

.title {
  width: 70%;
}

.author {
  width: 50%;
}

.price {
  width: 30%;
}

.quantity {
  width: 20%;
}

.status {
  width: 15%;
}

@keyframes placeHolderShimmer {
  0% {
    background-position: -450px 0;
  }
  100% {
    background-position: 450px 0;
  }
}

.animated-background {
  animation-duration: 1s;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
  animation-name: placeHolderShimmer;
  animation-timing-function: linear;
  background: #f6f7f8;
  background: linear-gradient(to right, #f5f4f3 8%, #ebebeb 18%, #f5f4f3 33%);
  background-size: 1200px 104px;
  position: relative;
}

.loading .image,
.loading .title,
.loading .author,
.loading .price,
.loading .quantity,
.loading .status {
  background: linear-gradient(to right, #eeeeee 0%, #dddddd 50%, #eeeeee 100%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}


        .container1 {
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            width: 100%;
            padding: 2rem;
        }
        .left-section {
            flex: 1;
            padding-right: 2rem;
        }
        .right-section {
            flex: 1;
            padding-left: 2rem;
            border-left: 1px solid #dee2e6;
        }
        .form-group {
            margin-bottom: 1rem;
        }
        .btn-success {
            background-color: #28a745;
            border: none;
        }
        .btn-success:hover {
            background-color: #218838;
        }
        h2, h4 {
            margin-bottom: 1rem;
        }
        .cart-item img {
            width: 150px;
            height: 150px;
            object-fit: cover;
        }
        .order-summary {
            background-color: #f8f9fa;
            padding: 1.5rem;
            border-radius: 0.375rem;
        }
        .btn-checkout {
            background-color:  rgb(64, 64, 233);

            border: 2px solid rgb(64, 64, 233);
            border-radius: 5px;
            padding: 4px;
            width: 350px;
            font-weight: 600;
            transition: .3s all ease-in-out;
            color: #fff;
        }
        .btn-checkout:hover{
            background-color: transparent;
            color: black;


        }
        .hidden {
      display: none;
      visibility: hidden;
    }
    .error {
      color: red;
    }
    .move{
            animation: remove .1s forwards;

        }

        @keyframes remove {
            100%{
                opacity: 0;
                visibility: hidden;
                display: none;
            }
        }


        .containered {
      --uib-size: 135px;
      --uib-color: black;
      --uib-speed: 1s;
      --uib-stroke: 3.5px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      width: var(--uib-size);
      height: calc(var(--uib-size) * 0.9);
    }
  
    .bar {
      width: 80px;
      height: 100%;
      background-color: #fff;
      transition: background-color 0.3s ease;
    }
  
    .bar:nth-child(1) {
      animation: grow var(--uib-speed) ease-in-out calc(var(--uib-speed) * -0.45)
        infinite;
    }
  
    .bar:nth-child(2) {
      animation: grow var(--uib-speed) ease-in-out calc(var(--uib-speed) * -0.3)
        infinite;
    }
  
    .bar:nth-child(3) {
      animation: grow var(--uib-speed) ease-in-out calc(var(--uib-speed) * -0.15)
        infinite;
    }
  
    .bar:nth-child(4) {
      animation: grow var(--uib-speed) ease-in-out infinite;
    }
  
    @keyframes grow {
      0%,
      100% {
        transform: scaleY(0.3);
      }
  
      50% {
        transform: scaleY(1);
      }
    }
    .animation{
        position: absolute;
        width: 100vw;
        height: 100vh;
        background-color: #000000d0;
        display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      color: white;
      top: 150px;
      z-index: 999;
    }
    .animation>p{
        font-size: 40px;
        font-weight: 800;
    }
    .body_style{
        height: 100vh;
        overflow: hidden;
    }
    .space{
        margin-right: 100px;
    }
    .bod{
        border:none;
    }
</style> 

