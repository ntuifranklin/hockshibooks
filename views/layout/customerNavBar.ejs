

    <div class="header-area header-area--default">

        <!-- Header Bottom Wrap Start -->
        <header class="header-area  header_height-90 header-sticky">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-4 col-md-4 d-none d-md-block">
                        <div class="header-left-search">
                            <form role="search" action="/books/search" method="POST" class="header-search-box">
                                <input class="search-field form-control" type="text" placeholder="Search Anything..."  name="query">

                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                
                                <button class="search-icon" type="submit">
                                    <i class="icon-magnifier"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-6">
                        <div class="logo text-md-center">
                            <a href="/"><img src="/assets/images/logo/hockshi.svg" width="200" height="100" alt="Hockshi.com logo image"></a>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-6">
                        <div class="header-right-side text-end">
                            <div class="header-right-items  d-none d-md-block">
                                <a href="#" >
                                    <i class="icon-user"></i>
                                </a>
                            </div>
                          

                            <div class="header-right-items">
                                <a href="/cart/view" class=" header-cart  header-icon">
                                    <i class="icon-bag2"></i>
                                    <script>
                                       
                                       
                                        window.addEventListener('load', async function() {
                                            await fetch('/cart/items')
                                            .then(response => response.json())
                                            .then(data => {
                                                //console.log(`cart items near cart icon: ${JSON.stringify(data)}`);
                                                if (typeof data != "undefined" && typeof data.length  != "undefined" && data.length > 0){
                                                    let total = 0;
                                                    for (let i = 0; i < data.length; i++){
                                                        total += data[i].qty;
                                                    } ;
                                                    let cartCount = document.getElementById('cart-count');
                                                    cartCount.innerHTML = total;
                                                    //class=""
                                                    //<span id="cart-count" class="item-counter"></span>
                                                    cartCount.classList.add('item-counter');
                                                }
                                                
                                            });
                                        });
                                            
                                    </script>
                                    <span id="cart-count"></span>
                                </a>
                            </div>
                            <div class="header-right-items d-block d-md-none">
                                <a href="javascript:void(0)" class="search-icon" id="search-overlay-trigger">
                                    <i class="icon-magnifier"></i>
                                </a>
                            </div>
                            <div class="header-right-items">
                                <a href="javascript:void(0)" class="mobile-navigation-icon" id="mobile-menu-trigger">
                                    <i class="icon-menu"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="cartUpdateResult" class="row" data-bs-dismiss="modal">

                </div>
            </div>
        </header>
        <!-- Header Bottom Wrap End -->

    </div>

    <div class="mobile-menu-overlay" id="mobile-menu-overlay">
        <div class="mobile-menu-overlay__inner">
            <div class="mobile-menu-close-box text-start">
                <span class="mobile-navigation-close-icon" id="mobile-menu-close-trigger"> <i class="icon-cross2"></i></span>
            </div>
            <div class="mobile-menu-overlay__body">
                <div class="offcanvas-menu-header d-md-block d-none">
                    
                </div>
                <nav class="offcanvas-navigation">
                    <ul>
                        <li class="has-children">
                            <a href="/">Home</a>
                            
                        </li>
                        <li class="has-children">
                            <a href="/books">Books</a>                     
                        </li>

                        <li class="has-children">
                            <a href="/cart/view">Shopping Cart</a>                            
                        </li>

                        <% //console.log('Customer in customer Nav Bar: ', JSON.stringify(customer, null, 2) ); %>
                        <% if( customer != null  && customer.customer_id != null) { %>
                            <li class="has-children">
                                <a href="/customer/profile">Profile</a>
                                
                            </li>
                            <li class="has-children">
                                <a href="/customer/logout">Logout</a>
                            </li>
                        <% } else { %>
                        <li class="has-children">
                            <a href="/customer/login">Login</a>                            
                        </li>
                        <li class="has-children">
                            <a href="/customer/signup">Signup</a>                            
                        </li>
                        <% }  %>
                        

                    </ul>
                </nav>

                <div class="mobile-menu-contact-info section-space--mt_60">
                    <h6>Contact Us</h6>
                    <p>
                        <i class="icon_pin"></i>
                        <%= companyName %> 
                        <%= companyCity  %> 
                        <%= companyState  %>, 
                        <%= companyZip %> 
                        <br>                        
                        <a href="#" id='customerNavBarAnchorEmailLink' class="hover-style-link">
                            <i class="icon_mail"></i>&nbsp;Email Us
                        </a>
                        <br>
                        <a href="#" class="hover-style-link" id="customerNavBarAnchorPhoneNumberLink"><i class="icon_phone"></i>&nbsp;Call Us</a>
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                let phoneNumberTag = document.querySelector('#customerNavBarAnchorPhoneNumberLink')
                                function revealPhoneNumberInCustomerNavBar(){
                                    
                                    //let allKeys = Object.keys(this);
                                    //console.log(`this keys: ${JSON.stringify(allKeys)}`);
                                    phoneNumberTag.href = 'tel:' + '<%= companyPhoneNumber %>';
                                    phoneNumberTag.innerHTML = '<i class="icon_phone"></i>&nbsp;<%= companyPhoneNumber %>';
                                    
                                }
                                phoneNumberTag.addEventListener('click',revealPhoneNumberInCustomerNavBar) ;
                                phoneNumberTag.addEventListener('mouseover',revealPhoneNumberInCustomerNavBar) ;
                                let emailTag = document.querySelector('#customerNavBarAnchorEmailLink')
                                function revealEmailInCustomerNavBar(){
                                    
                                    emailTag.href = 'mailto:' + '<%= customerBusinessEmail %>';
                                    emailTag.innerHTML = '<i class="icon_mail"></i>&nbsp;<%= customerBusinessEmail %>';
                                } ;
                                emailTag.addEventListener('click',revealEmailInCustomerNavBar) ;
                                emailTag.addEventListener('mouseover',revealEmailInCustomerNavBar) ;
                            });
                        </script>
                    </p>
                </div>

                <div class="mobile-menu-social-share section-space--mt_60">
                    <h6>Follow US On Socials</h6>
                    <ul class="social-share">
                        <li><a href="<%= facebookpage %>"><i class="social social_facebook"></i></a></li>
                        <li><a href="<%= xpage %>"><i class="social social_twitter"></i></a></li>
                        <li><a href="<%= instagrampage %>"><i class="social social_instagram"></i></a></li>
                        <li><a href="<%= linkedinpage %>"><i class="social social_linkedin"></i></a></li>
                    </ul>
                </div>


            </div>


        </div>


    </div>

