<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= emailTitle %></title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%- include('../partials/defaultcommoncss') %>
  </head>
<body class="">

    <div id="main-wrapper">
        <div class="site-wrapper-reveal border-bottom">   
          
          <!-- Email Wrapper -->
          <div class="container py-5">
            <div class="row justify-content-center">
              <div class="col-12 col-md-8">
                <div class="card">
                  <div class="card-header bg-primary text-white text-center">
                    <h2 class="m-0">Order Confirmation</h2>
                  </div>
                  <div class="card-body">
                    <h3 class="text-dark">Hello, <%=customerName || "Guest User"%>!</h3>
                    <p class="text-muted">Thank you for your order! We're excited to get it ready for you. you will receive another email once your order has been shipped.</p>
                    
                    <h4 class="text-dark">Order ID: <%=orderId%></h4>
                    <!-- Book Ordered -->
                    <h4 class="text-dark">Book(s) Ordered:</h4>
                    <table class="table table-bordered mb-4">
                      <tbody>
                        
                        <% for(let i=0; i < orderList.length; i++) { %>                      

                          <tr>
                            <td><strong>Title:</strong></td>
                            <td><%= orderList[i].title %></td>
                          </tr>
                          <tr>
                            <td><strong>Quantity:</strong></td>
                            <td><%= orderList[i].quantity %></td>
                          </tr>
                          <tr>
                            <td><strong>Price:</strong></td>
                            <td>$<%= orderList[i].price %></td>
                          </tr>
                          <tr>
                            <td><strong>Sub Total:</strong></td>
                            <td>$<%= orderList[i].subtotal %></td>
                          </tr>
                          <tr>
                            <td>
                              <hr>
                            </td>
                          </tr>
                          
                          
                        <% } %>
                            <tr>
                              <td><strong>Total:</strong></td>
                              <td>$<%= totalAmount.toFixed(2) %></td>
                            </tr>
                        
                      </tbody>
                    </table>
        
                    <!-- Shipping Address -->
                    <h4 class="text-dark">Shipping Address:</h4>
                    <p class="text-muted">
                      <%= shippingAddress %><br>
                      <%= shippingCity %> <%= shippingState %><br>
                      <%= shippingCountry %> <%= shippingPostalCode %>
                    </p>
                     
                    <p>
                      If you have not created an account with us, you can still <a href="<%= askGuestToCreateAccountLink %>">track your order as a guest using this link</a>
                    </p>
        
                    <p class="text-muted">Your book will be shipped to the above address shortly. You will receive an email notification once it's on its way!</p>
        
                    <p class="text-muted">Thank you for shopping with us. If you have any questions, feel free to contact our customer service team.</p>
                  </div>
                  <div class="card-footer bg-light text-center py-3">
                    <p class="mb-0 text-muted">&copy; 2023-<%= (new Date()).getFullYear() %> <%= companyName %>, All rights reserved.</p>
                    
                    <a href="<%= termsAndConditionsLink %>" class="text-primary">Terms & Conditions</a>
                    
                    <a href="<%= privacyPolicyLink %>" class="text-primary">Privacy Policy</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- End Email Wrapper -->
          
      
        </div>
      </div>

      
  <%- include('../partials/commonjslibs'); %>
 


</body>

</html>
