    <div id="main-wrapper" style="width: 100%; margin: 0; padding: 0;">
        <div class="site-wrapper-reveal border-bottom" style="border-bottom: 1px solid #ddd; padding: 10px; margin: 0;">
      
          <div class="my-account-page-wrapper" style="padding-top: 120px; padding-bottom: 120px;">
            <div class="container" style="width: 100%; max-width: 1140px; margin: 0 auto;">
              <div class="row" style="display: flex; justify-content: center;">
                <div class="col-lg-6 col-md-7 m-auto" style="width: 100%; max-width: 600px; margin: auto;">
                  <div class="myaccount-box-wrapper" style="background-color: #f9f9f9; padding: 30px; border-radius: 8px; box-shadow: 0px 5px 15px rgba(0,0,0,0.1);">
                    <div class="helendo-tabs" style="text-align: center;">
      
                    </div>
                    <div class="tab-content content-modal-box" style="margin-top: 30px;">
                      <div class="tab-pane fade show active" id="tab_list_06" role="tabpanel">
                        <h1 style="font-size: 32px; color: #333; text-align: center; margin-bottom: 20px; font-weight: bold;">A New Order Was Made </h1>
                        <p style="font-size: 16px; color: #666; text-align: center; margin-bottom: 30px;">Hi <b> Super Admin</b>, </p>
                        <p style="font-size: 16px; color: #666; text-align: center; margin-bottom: 30px;">  A new order has been placed on the platform.                        </p>
                        <p style="font-size: 16px; color: #666; text-align: center; margin-bottom: 30px;">   <b>Order ID: </b> <%=orderId%></p>
                        <p style="font-size: 16px; color: #666; text-align: center; margin-bottom: 30px;">   <b>customer Name: </b> <%=customerName%></p>
                        <p style="font-size: 16px; color: #666; text-align: center; margin-bottom: 30px;">   <b>Total Amount: </b> $ <%=total%></p>
                        <p style="font-size: 16px; color: #666; text-align: center; margin-bottom: 30px;">   <b>Order Date: </b> <%=orderDate%></p>

                        <p style="font-size: 16px; color: #666; text-align: center; margin-bottom: 30px;">  Please review the order in the admin dashboard and initiate the necessary processing.
                        </p>
      
                        
                      </div>
