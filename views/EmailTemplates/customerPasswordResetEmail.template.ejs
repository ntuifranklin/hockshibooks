<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= emailTitle %></title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%- include('../partials/defaultcommoncss') %>
  </head>
<body class="">

    <div id="main-wrapper">
        <div class="site-wrapper-reveal border-bottom">   
          
          <!-- Email Wrapper -->
          <div class="container py-5">
            <div class="row justify-content-center">
              <div class="col-12 col-md-8">
                <div class="card">
                  <div class="card-header bg-primary text-white text-center">
                    <h2 class="m-0">A request for password reset was made with your email address </h2>
                  </div>
                  <div class="card-body">
                    
                     
        
                    <p class="mb-0">You are receiving this email because a request for password reset was made with your email address. If you did not make this request, please ignore this email.</p>
        
                    <p class="mb-0">To reset your password, click the button below:</p>
        
                    <div class="text-center mt-4">
                      <a href="<%= resetPasswordLink %>" class="btn btn-primary">Reset Password</a>
                    </div>
        
                    <p class="mb-0">If you're having trouble clicking the "Reset Password" button, copy and paste the URL below into your web browser:</p>
        
                    <p class="mb-0"><a href="<%= resetPasswordLink %>"><%= resetPasswordLink %></a></p>
        
                    <p class="mb-0">This link will expire in <%= expiryTime %> minutes.</p>
                  </div>
                  <div class="card-footer bg-light text-center py-3">
                    <p class="mb-0 text-muted">&copy; 2023-<%= (new Date()).getFullYear() %> <%= companyName %>, All rights reserved.</p>
                    
                    <a href="<%= termsAndConditionsLink %>" class="text-primary">Terms & Conditions</a>
                    
                    <a href="<%= privacyPolicyLink %>" class="text-primary">Privacy Policy</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- End Email Wrapper -->
          
      
        </div>
      </div>

      
  <%- include('../partials/commonjslibs'); %>
 


</body>

</html>
