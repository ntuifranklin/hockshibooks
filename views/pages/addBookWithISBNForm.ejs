<%- include('../partials/pagehead') %>

<%  if (user) { %>
        <%- include('navBar',{email:user.email,role:user.role,host:host}) %>
<% } %>
    <div class="container">
        
        <h1>Add a book with ISBN</h1>
        <p>You can always change them later.</p>
        <div class="errors">
            <% if (msg) { %>
                                        
                    <div class="alert alert-danger" role="alert">
                        <p><%= msg.msg %>!</p>
                    </div>
            <% } %>

        </div>
        <form method="post" action="<%= `${host}/admin/books/addBookWithISBN` %>">
            <div class="input-group">
                <label for="isbn">ISBN</label>
                <input type="text" id="isbn" placeholder="The ISBN can be 10 or 13 caracters long" name="isbn">
            </div>
            <div class="input-group">
                <label for="displayName">price</label>
                <input type="number" id="displayName" placeholder="$25 is the default price" name="price">
            </div>
            <input type="hidden" name="_csrf"
            value="<%= csrfToken %>">
            <button type="submit">Insert Book</button>
        </form>
    </div>



    <%- include('../partials/commonjslibs'); %>
    

</body>

</html>
