        <div class="product-wrapper section-space--ptb_120 ">
          <div class="timeline-wrapper">
            <div class="timeline-item">
            </div>
            <div class="timeline-item">
                <div class="animated-background">
                    <div class="background-masker content-top"></div>
                    <div class="background-masker content-first-end"></div>
                    <div class="background-masker content-second-line"></div>
                    <div class="background-masker content-second-end"></div>
                    <div class="background-masker content-third-line"></div>
                    <div class="background-masker content-third-end"></div>
                </div>
            </div>
            <div class="timeline-item">
                <div class="animated-background">
                    <div class="background-masker content-top"></div>
                    <div class="background-masker content-first-end"></div>
                    <div class="background-masker content-second-line"></div>
                    <div class="background-masker content-second-end"></div>
                    <div class="background-masker content-third-line"></div>
                    <div class="background-masker content-third-end"></div>
                </div>
            </div>
            <div class="timeline-item">
                <div class="animated-background">
                    <div class="background-masker content-top"></div>
                    <div class="background-masker content-first-end"></div>
                    <div class="background-masker content-second-line"></div>
                    <div class="background-masker content-second-end"></div>
                    <div class="background-masker content-third-line"></div>
                    <div class="background-masker content-third-end"></div>
                </div>
            </div>
            <div class="timeline-item">
                <div class="animated-background">
                    <div class="background-masker content-top"></div>
                    <div class="background-masker content-first-end"></div>
                    <div class="background-masker content-second-line"></div>
                    <div class="background-masker content-second-end"></div>
                    <div class="background-masker content-third-line"></div>
                    <div class="background-masker content-third-end"></div>
                </div>
            </div>
        </div>
            <div class="container product-list hidden">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title text-center mb-20">
                            <h2 class="section-title--one section-title--center">Best Selling</h2>
                        </div>
                    </div>
                </div>

                <div class="product-slider-active">

                    <!-- Single Product Item Start -->
                    <% if(books.length>0) { %>
                      <% for(let i=0; i < books.length; i++) { %>
      
                  
                
      
                 
                    <div class="single-product-item text-center">
                        <div class="products-images">
                            <a href="/productDetails/<%=`${books[i].book_id} `%>" class="product-thumbnail">

                              <% if(books[i].cover_image_url.split(":")[0]=="https") { %>
                                <img  src="<%=`${books[i].cover_image_url}`%>" class="img-fluid bookCoverImage" alt="Product Images"  >
                                <% } else { %>
                                  <img  src="/uploads/<%=`${books[i].cover_image_url}`%>" class="img-fluid bookCoverImage" alt="Product Images"  >
              
                                  <% } %>

                                  <% if (books[i].Inventory.quantity_available <= 0) { %>
                                <span class="ribbon out-of-stock">
                                Out Of Stock
                            </span>
                            <% } %>
                            </a>
                            <div class="product-actions">
                              <a href="/productDetails/<%=`${books[i].book_id} `%>"  data-bs-target="#prodect-modal"><i class="p-icon icon-plus"></i><span class="tool-tip">Quick View</span></a>
                              <% if (books[i].Inventory.quantity_available>0) { %>
                                <a class="add-to-cart"><i class="p-icon icon-bag2 " data-product-id="<%= books[i].book_id %>"></i> <span class="tool-tip">Add to cart</span></a>
                                <% } %>
                            </div>
                        </div>
                        <div class="product-content">
                            <h6 class="prodect-title"><a href="/productDetails/<%=`${books[i].book_id} `%>"><%=books[i].title %></a></h6>
                            <div class="prodect-price">
                                <span class="new-price">$<%=books[i].price %></span>
                            </div>
                        </div>
                    </div><!-- Single Product Item End -->
                    <% } %>
                    <% } %>
                </div>
            </div>
        </div>


       

      

        <div class="our-newsletter-area">
            <div class="container">
                <div class="row">
                    <div class="col-lg-5 col-md-4">
                        <div class="section-title small-mb__40 tablet-mb__40">
