<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Button UI</title>
    <style>
        button a{
            color: white;
            text-decoration: none;

        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: linear-gradient(135deg, #e0e0e0, #f8f8f8);
            margin: 0;
            font-family: Arial, sans-serif;
        }
        .button-container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .button-container button {
            margin: 10px;
            padding: 15px 40px;
            border: none;
            border-radius: 30px;
            font-size: 18px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        .checkout {
            background-color: #007bff;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            position: relative;
        }
        .checkout span {
            position: absolute;
            right: 20px;
            font-size: 14px;
            color: rgba(255, 255, 255, 0.7);
        }
        .cancel {
            background-color: white;
            color: #007bff;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .signup {
            background-color: white;
            color: #007bff;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .signup a{
            color: #007bff;

        }
        .login {
            background-color: #007bff;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <div class="button-container">
        <button class="checkout">it looks like you are not logged in </button>
        <div style="display: flex; gap: 10px;">
            <button class="signup"><a href="/login">login</a></button>
            <button class="login"><a href="/showForm">continue as geust</a></button>
        </div>
    </div>
</body>
</html>
