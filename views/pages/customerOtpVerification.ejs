    <style>
body {
    font-family: 'Arial', sans-serif;
    background-color: #f4f4f9;
    margin: 0;
    padding: 0;
}

.login-section {
    background-color: #fff;
}

.login-box {
    width: 300px;
}

.login-box h2 {
    font-size: 24px;
    margin-bottom: 20px;
}

.login-box h2 span {
    font-weight: bold;
}

.otp-input {
    display: flex;
    justify-content: center;
    margin: 20px 0;
}

.otp-field {
    width: 300px;
    height: 50px;
    margin: 0 5px;
    text-align: center;
    font-size: 24px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

.dashboard-section {
    background-color: #f9f9fb;
    overflow-y: auto;
}

.dashboard-content {
    padding: 20px;
}

.card {
    border: none;
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.card-title {
    font-size: 18px;
    margin-bottom: 10px;
}

.revenueChart, .salesChart {
    height: 200px !important;
}

.rounded-circle {
    width: 40px;
    height: 40px;
}


    </style>
</head>
