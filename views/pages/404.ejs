<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Error Page</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #fff;
}

.container {
    max-width: 600px;
    margin: 0 auto;
    padding: 20px;
    text-align: center;
}

.paypal-header img {
    margin-top: 20px;
}

.error-message {
    margin-top: 50px;
}

.error-message h1 {
    font-size: 36px;
    color: #555;
}

.error-message p {
    font-size: 18px;
    color: #555;
}

.cookie-consent {
    background-color: #003087;
    color: #fff;
    padding: 20px;
    margin-top: 30px;
}

.cookie-consent p {
    margin: 10px 0;
    font-size: 14px;
}

.cookie-consent a {
    color: #fff;
    text-decoration: underline;
}

.cookie-consent .btn-primary {
    background-color: #0070ba;
    border-color: #0070ba;
    margin-top: 10px;
}

    </style>

</head>
<body>
    <div class="container text-center">
        <div class="paypal-header">

        </div>
        <div class="error-message">
            <h1>Sorry.</h1>
            <p>It looks like nothing was found at this location. </p>
        </div>
       
    </div>
</body>
</html>
