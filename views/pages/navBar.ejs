<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
    html,
body,
.intro {
height: 100%;
}

table td,
table th {
text-overflow: ellipsis;
white-space: nowrap;
overflow: hidden;
}

thead th,
tbody th {
color: #fff;
}

tbody td {
font-weight: 500;
color: rgba(255,255,255,.65);
}

.card {
border-radius: .5rem;
}
@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800&display=swap");


body{

background-color: #eee;
font-family: "Poppins", sans-serif;
font-weight: 300;


}

.btn{

border-radius: 25px;

}

.new{
    font-size: 12px;
}

.card{

padding: 20px;
border:none;
}

li{
  color:white
}


.active{

background: #f6f7fb !important;
border-color: #f6f7fb !important;
color: #000 !important;
    font-size: 12px;

}

.inputs{

position: relative;

}

.form-control {
    text-indent: 15px;
border: none;
height: 45px;
border-radius: 0px;
border-bottom: 1px solid #eee;
background-color: transparent;
}

.form-control::placeholder{
color: white;
}
.form-control:focus {
color: #495057;
border-color: #eee;
background-color: transparent;
outline: 0;
box-shadow: none;
color: white;
border-bottom: 1px solid blue;
}

.navlinks{
  display: flex;
  gap: 90px;
}

.links{
  margin: auto;
  
}


.inputs i{

    position: absolute;
top: 14px;
left: 4px;
color: #b8b9bc;
}
li>a{
  color: white;
  text-decoration: none;
}


</style>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark">
      <a class="navbar-brand" href="/admin/dashboard">Hockshi Admin</a>
      
      <div class="collapse navbar-collapse nav-flex" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto navlinks links">
          <li class="nav-item links">
            
            <a href="<%=host%>/admin/dashboard">dashboard</a>

            <!-- user role -->
        </li>
        <li class="nav-item">
            
          <a href="<%=host%>/admin/books/insert-book">insert a book</a>
          
          <!-- user role -->
      </li>
          
        </ul>
    
        <ul class="navbar-nav navlinks">
          <li class="nav-item">
            
              <i class="fa fa-globe"></i>
              <%= role %>
              <!-- user role -->
          </li>
          <li class="nav-item">
            
            <i class="fa fa-user"></i>
            <%= email %>
            <!-- user role -->
        </li>
         
          <li class="nav-item">
            <a  href="/admin/logout" class="btn bg-white nav-link text-dark">
              log out
            </a>
          </li>
        </ul>
      </div>
    </nav>
    </header>
  
</body>
</html>