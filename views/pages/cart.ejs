                <div class="loading-container">

                    <div class="cart-item loading">
                      <div class="image animated-background"></div>
                      <div class="content">
                        <div class="title animated-background"></div>
                        <div class="author animated-background"></div>
                        <div class="price animated-background"></div>
                        <div class="quantity animated-background"></div>
                        <div class="status animated-background"></div>
                      </div>
                    </div>
                    
                    <div class="cart-item loading">
                      <div class="image animated-background"></div>
                      <div class="content">
                        <div class="title animated-background"></div>
                        <div class="author animated-background"></div>
                        <div class="price animated-background"></div>
                        <div class="quantity animated-background"></div>
                        <div class="status animated-background"></div>
                      </div>
                    </div>
                    
                </div>
                <div class="checkout-wrap hidden" >
                    <div class="row">
                        <div class="col-lg-7">
                            <div class="billing-info-wrap mr-100">
                                <h6 class="mb-20">Billing Details</h6>
                                <div class="row">
                                    <form  id="checkout">
                                   
                                    <div class="col-lg-12">
                                        <div class="billing-select mb-25">
                                            <label>Country <span class="required" title="required">*</span></label>
                                            <select class="select-active" name="country" id="country">
                                                <% for(let i=0; i < country.length; i++) { %>
                                                    
                                                      <option value="<%= country[i].country_name %>"><%= country[i].country_name %></option> 
                                                      <% } %>
                                            </select>
                          <p id="countryError" class="error"></p>

                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="billing-select mb-25">
                                            <label>State <span class="required" title="required">*</span></label>
                                            <select class="select-active" name="state" id="state">
                                                <% for(let i=0; i < states.length; i++) { %>
                                                    
                                                      <option value="<%= states[i].province_state_name %>"><%= states[i].province_state_name %></option> 
                                                      <% } %>
                                            </select>

                          <p id="stateError" class="error"></p>

                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="billing-info mb-25">
                                            <label>shipping address <span class="required" title="required">*</span></label>
                                            <input class="billing-address" placeholder="House number and street name" type="text" name="address" id="address">
                      <p id="addressError" class="error"></p>
                                        
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="billing-info mb-25">
                                            <label>Town / City <span class="required" title="required">*</span></label>
                                            <input type="text" name="city" id="city">
                      <p id="cityError" class="error"></p>

                                        </div>
                                    </div>
                                   
                                    <div class="col-lg-12 col-md-12">
                                        <div class="billing-info mb-25">
                                            <label>Postcode / ZIP (optional) <span class="required" title="required">*</span></label>
                                            <input type="text" name="postal code" id="postalCode">
                          <p id="postalCodeError" class="error"></p>

                                        </div>
                                    </div>

                                    <div class="place-order mt-30">
                                        <button type="submit" class="btn--full btn--black btn--lg text-center">Place Order</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-lg-5">
                           
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- checkout end -->
    </div>

    

























    <%- include('../layout/footer') %>

</div>


