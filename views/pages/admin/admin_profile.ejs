<%- include('../../partials/pagehead') %>


<%  if (user) { %>
    <%- include('./navBar',{email:user.email,role:user.role,host:host}) %>
<% } %>


<div id="main-wrapper">
    <div class="site-wrapper-reveal border-bottom">

        <div class="my-account-page-warpper section-space--ptb_120">
            <div class="container">
                <div class="row">
                    <div class="col">
                        <!-- My Account Page Start -->
                        <div class="myaccount-page-wrapper">
                            <div class="row">

                                

                                <!-- My Account Tab Content Start -->
                                <div class="col-lg-9 col-md-8">
                                    <div class="tab-content" id="myaccountContent">

                                        <% if (errors) { %>
                                            <div class="errors">
                                                    <% for(let i=0; i < errors.length; i++) { %>
                                                                            
                                                        
                                                        <div class="alert alert-danger alert-dismissible fade show"  role="alert">
                                                            <p><%= errors[i].msg %>!</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

                                                        </div>
                                                        <% } %>
                                                        
                                                    </div>
                                                    <% } %>

                                                    <% if (msg) { %>
                                                        <div class="alert alert-<%=type%> alert-dismissible fade show" role="alert">
                                                            <p><%= msg %>!</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

                                                        </div>
                                                    <% } %>
                                        <!-- Single Tab Content Start -->
                                        <div class="tab-pane show active" id="account-info" role="tabpanel">
                                            <div class="myaccount-content">
                                                <h3 class="title">Account Details</h3>
                                                <div class="account-details-form">
                                                    <form action="<%=host%><%=admin_route%>/adminProfile " method="post" >
                                                        
                                                        <div class="single-input-item mb-3">
                                                            <label for="email" class="required mb-1">Email Addres</label>
                                                            <input type="email" id="email" placeholder="New Email Address" name="email" autocomplete="on" value="<%=email%>"/>
                                                        </div>
                                                        <fieldset>
                                                            <legend>Password change</legend>
                                                            
                                                            <div class="row">
                                                                <div class="col-lg-6">
                                                                    <div class="single-input-item mb-3">
                                                                        <label for="new-pwd" class="required mb-1">current Password</label>

                                                                        <input type="password" autocomplete="new-password"   id="new-pwd" placeholder="New Password" name="Old_password" />
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-6">
                                                                    <div class="single-input-item mb-3">
                                                                        <label for="confirm-pwd" class="required mb-1">New Password</label>
                                                                        <input type="password" id="confirm-pwd" placeholder="Confirm Password"  name="New_password"/>
                                                                    </div>
                                                                </div>

                                                                <input type="hidden" name="_csrf"
                                                        value="<%= csrfToken %>">
                                                            </div>
                                                        </fieldset>
                                                        <div class="single-input-item single-item-button">
                                                            <button class="btn btn btn-dark btn-hover-primary rounded-0">Save Changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div> <!-- Single Tab Content End -->

                                    </div>
                                </div>
                                <!-- My Account Tab Content End -->

                            </div>
                        </div>
                        <!-- My Account Page End -->
                    </div>
                </div>
            </div>
        </div>

    </div>

    


























</div>


    
<%- include('../../partials/admin_jslibs') %>


</body>

</html>