<%- include('../../partials/pagehead') %>
<%  if (user) { %>
  <%- include('./navBar',{email:user.email,role:user.role,host:host}) %>
<% } %>

<section class="m-auto d-flex justify-content-center align-items-center vw-100 vh-100" style="background-color: hsl(0, 0%, 96%)">
    <div class="px-4 py-5 px-md-5 text-center text-lg-start" >
      <div class="container">
        <div class="row gx-lg-5 align-items-center">
          <div class="col-lg-6 mb-5 mb-lg-0">
            <h1 class="my-5 display-3 fw-bold ls-tight">
              Welcome<br />
              <span class="text-primary">hockshi admin </span>
            </h1>
            <p style="color: hsl(217, 10%, 50.8%)">
             
            </p>
          </div>
  
          <div class="col-lg-6 mb-5 mb-lg-0">
            <% if (msg) { %>
              <div class="alert alert-danger" role="alert">
                    <p><%= msg %>!</p>
              </div>
            <% } %>
            
            <div class="card">
              <div class="card-body py-5 px-md-5">
                <form action="/admin" method="post" >
                  <!-- 2 column grid layout with text inputs for the first and last names -->
                  
  
                  <!-- Email input -->
                  <div data-mdb-input-init class="form-outline mb-4">
                    <label class="form-label" for="form3Example3">Email address</label>

                    <input type="email" id="form3Example3" class="form-control"  name="email"/>
                  </div>
  
                  <!-- Password input -->
                  <div data-mdb-input-init class="form-outline mb-4">
                    <label class="form-label" for="form3Example4">Password</label>

                    <input type="password" id="form3Example4" class="form-control" name="password" />
                  </div>
  
                  
                    <input type="hidden" name="_csrf"
                value="<%= csrfToken %>">
                  <!-- Submit button -->
                  <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-block mb-4">
                    Sign in
                  </button>
  
               
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
</section>
    
<%- include('../../partials/admin_jslibs') %>


</body>

</html>