<%- include('../partials/pagehead') %>

<%- include('../layout/customerNavBar') %>


<%- include('../partials/breadcrumbs') %>


   

    <%  if (user) { %>
        <%- include('./navBar',{email:user.email,role:user.role,host:host}) %>
        <% } %>

   

    <div class="container">
     

        <div id="main-wrapper">
            <div class="site-wrapper-reveal border-bottom">
        
                <div class="my-account-page-warpper section-space--ptb_120">
                    <div class="container">
                        <div class="errors">
                            <% if (msg) { %>
                                <% for(let i=0; i < msg.length; i++) { %>
                                                        
                                    
                                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                        <p><%= msg[i].msg %>!</p>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

                                    </div>
                                    <% } %>
                            <% } %>
        
                        </div>

                        <div class="form-header">
                            <h2>INSERT A  BOOK</h2>
                          
                        </div>
                            </div>
                        <div class="row">
                            <div class="col-lg-6 col-md-7 m-auto">
                                <div class="myaccount-box-wrapper">
                                 
                                    <div class="tab-content content-modal-box">
                                      
                                        <div class="tab-pane fade show active"  >
        
                                            <form enctype="multipart/form-data" action="<%=books_route%>/insert-book?_csrf=<%= csrfToken%>"  method="post" class="account-form-box">

                                                <div class="form-row">
                                                    <div class="form-group single-input">
                                                        <label  class="w-100">Title:
                                                            <input type="text" class="form-control" id="Book_Title" placeholder="Book Title"  name="title" value="<%= formdata.title %>">  

        
                                                        </label>
                                                    </div>
                                                    <div class="form-group single-input">
                                                        <label for="" class="w-100">Author Name:
                                                            <input type="text" class="form-control" id="autho" placeholder="Book Author"  name="author" value="<%= formdata.author %>">
        
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="single-input">
                                                    <label for="" class="w-100">ISBN:
        
                                                        <input type="text" class="form-control" id="ISBN" placeholder="ISBN" name="ISBN"  name="ISBN" value="<%= formdata.ISBN %>">
                                                    </label>
                                                </div>
                                                <div class="single-input">
                                                    <label for="" class="w-100">Language:
        
                                                        <input type="text" class="form-control" id="phone" placeholder="language" name="language" value="<%= formdata.language %>">
                                                    </label>
        
                                                </div>
                                                <div class="single-input">
                                                    <label for="" class="w-100">Unit Price:
        
        
                                                        <input type="number" class="form-control" id="price" placeholder="Price" name="price" value="<%= formdata.price%>">
                                                    </label>
        
                                                </div>
                                                <div class="single-input">
                                                    <label for="" class="w-100">Quantity Available:
         
                                                        <input type="number" class="form-control" placeholder="Quantity" name="quantity" value="<%= formdata.quantity%>">
        
                                                    </label>
        
                                                </div>
                                                
                                                <div class="single-input">
                                                    <label for="" class="w-100">
                                                        Location:
        
                                <input type="text" class="form-control" id="location" placeholder="Location" name="location" value="<%= formdata.location %>">
                                                    </label>
        
                                                </div>
                                                <div class="single-input">
                                                    <label for="" class="w-100">Cover Image:
        
                                                        <input type="file"  id="customFile"  name="coverImage">
        
                                                    </label>
                                                </div>

                                                <div class="single-input">
                                                    <label for="" class="w-100">Release Date:
        
                                                        <input type="date" class="form-control" id="date" name="date" value="<%= formdata.date %>">
        
                                                    </label>
                                                </div>
                                                <div class="single-input">
        
                                                    <label for="" class="w-100">Description:
        
                                                        <textarea type="date" class="form-control" id="description" name="description"  rows="3" cols="100" resize="none" width="200px"><%= formdata.description %></textarea>
                                                    </label>
        
                                                </div>
                                            
        
                                                <input type="hidden" name="_csrf"
                                                value="<%= csrfToken %>">
                                                <div class="button-box mt-25">
                                                    <button type="submit" class="btn btn--full btn--black">Save updates</button>
                                                </div>
                                            </form>
                                        </div>
        
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        
            </div>
        
            
            <!--====================  End of footer area  ====================-->
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        </div>
    </div>

    
    <%- include('../partials/jslibs') %>


</body>

</html>