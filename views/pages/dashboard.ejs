<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    
</head>
<body>

  <%- if (user) { %>
  <%- include('navBar',{email:user.email,role:user.role,host:host}) %>
  <%- } %>
  
    <section class="intro">
        <div class="bg-image h-100" >
          <div class="mask d-flex align-items-center h-100" style="background-color: rgba(0,0,0,.25);">
            <div class="container">
                <div class="mb-4">

                    <a href="<%= `${host}/admin/books/insert-book` %>"  class="btn btn-primary new p-10 w-25 h-50 "><i class="fa fa-plus"></i> New</a>
                    
                  </div>
                  
         <% if (msg) { %>
          <div class="alert alert-<%=type %>" role="alert">
                <p><%= msg %>!</p>
          </div>
        <% } %>  
                  
              <div class="row justify-content-center">
                
                <div class="col-12">
                  <div class="card bg-dark shadow-2-strong">
                    <div class="card-body">
                      <div class="table-responsive">
                        <table class="table table-dark table-borderless mb-0">
                          <thead>
                            <tr>
                              <th scope="col">Title</th>
                              <th scope="col">Author</th>
                              <th scope="col">ISBN</th>
                              <th scope="col">Price</th>
                              <th scope="col">Genre</th>
                              <th scope="col">Qty</th>
                              <th scope="col">Actions</th>



                            </tr>
                          </thead>
                          <tbody>
                            <% for(let i=0; i < books.length; i++) { %>
                            <tr>
                              <th scope="row"><%= books[i].title %></th>
                              <td><%= books[i].author %></td>
                              <td><%= books[i].ISBN %></td>
                              <td>$<%= books[i].price %></td>
                              <td><%= books[i].Genre.name %></td>
                              <td><%= books[i].Inventory.quantity_available %></td>

                              <td><div class="actions d-flex justify-content-between align-items-center">
                                <a href="<%= `/admin/books/update/${books[i].book_id}` %>"><i class="fa-solid fa-pen-to-square"></i></a>
                                <a href="<%= `/admin/books/delete/${books[i].book_id}` %>"><i class="fa-solid fa-trash"></i></a>
                                
                                <% } %>
                              </div></td>


                            </tr>
                  
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      
    
</body>
</html>