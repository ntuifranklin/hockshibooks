<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>home page</title>

   <link rel="stylesheet" href="../assets/css/homepage.css">

    
</head>
<body>

  <%- include('../layout/customerNavBar') %>
  <div id="main-wrapper">
    <div class="site-wrapper-reveal">

        <div class="hero-box-area mt-md-0 mt-lg-3">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-12 ps-0 ps-lg-3 pe-0 pe-lg-3">

                        <!-- Hero Slider Area Start -->
                        <div class="hero-area hero-slider-one">
                            <div class="single-hero-slider-one bg-img" data-bg="../assets/images/bg/img1.jpg">
                                <div class="container">
                                    <div class="row">
                                        <div class="col-lg-12">

                                            <div id="overlay"></div>

                                            <div class="hero-text-one">
                                                <h6 class="text-white mb-10">
                                                    Book <br> COLLECTION <br> 2024
                                                </h6>
                                                <h1 class="hero-title text-white">
                                                    Welcome To <br> Hockshi Store
                                                </h1>
                                                <p class="mt-30 text-white"> Many desktop publishing packages and web page editors now use <br>
                                            Lorem Ipsum as their default model text
                                                </p>
                                                <div class="button-box mt-30">
                                                    <a href="/books" class="hero-btn-one btn">Shop now <i class="icon-arrow-right"></i></a>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="single-hero-slider-one bg-img" data-bg="../assets/images/bg/img2.jpg">
                                <div class="container">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="hero-text-one">
                                                <h6 class=" mb-10">
                                                    CHAIR <br> COLLECTION <br> 2022
                                                </h6>
                                                <h1 class="hero-title ">
                                                    Welcome To <br> Helendo Store
                                                </h1>
                                                <p class="mt-30 "> Many desktop publishing packages and web page editors now use <br>
                                            Lorem Ipsum as their default model text
                                                </p>
                                                <div class="button-box mt-30">
                                                    <a href="/books" class="hero-btn-one btn">Shop now <i class="icon-arrow-right"></i></a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="single-hero-slider-one bg-img" data-bg="../assets/images/bg/img3.jpg">
                                <div class="container">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="hero-text-one">
                                                <h6 class="text-white mb-10">
                                                    CHAIR <br> COLLECTION <br> 2022
                                                </h6>
                                                <h1 class="hero-title text-white">
                                                    Welcome To <br> Helendo Store
                                                </h1>
                                                <p class="mt-30 text-white"> Many desktop publishing packages and web page editors now use <br>
                                            Lorem Ipsum as their default model text
                                                </p>
                                                <div class="button-box mt-30">
                                                    <a href="/books" class="hero-btn-one btn">Shop now <i class="icon-arrow-right"></i></a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Hero Slider Area End -->

                    </div>
                </div>
            </div>
        </div>
        <div class="about-us-area section-space--ptb_120">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="about-us-content_6 text-center">
                            <h2>Hockshi Book Store</h2>
                            <p>When you start with a portrait and search for a pure form, a clear volume, through successive eliminations,
                                you arrive inevitably at the egg. Likewise, starting with the egg and following the same process in reverse,
                                one finishes with the portrait.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
      

        <div class="product-wrapper section-space--ptb_120 ">
          <div class="timeline-wrapper">
            <div class="timeline-item">
            </div>
            <div class="timeline-item">
                <div class="animated-background">
                    <div class="background-masker content-top"></div>
                    <div class="background-masker content-first-end"></div>
                    <div class="background-masker content-second-line"></div>
                    <div class="background-masker content-second-end"></div>
                    <div class="background-masker content-third-line"></div>
                    <div class="background-masker content-third-end"></div>
                </div>
            </div>
            <div class="timeline-item">
                <div class="animated-background">
                    <div class="background-masker content-top"></div>
                    <div class="background-masker content-first-end"></div>
                    <div class="background-masker content-second-line"></div>
                    <div class="background-masker content-second-end"></div>
                    <div class="background-masker content-third-line"></div>
                    <div class="background-masker content-third-end"></div>
                </div>
            </div>
            <div class="timeline-item">
                <div class="animated-background">
                    <div class="background-masker content-top"></div>
                    <div class="background-masker content-first-end"></div>
                    <div class="background-masker content-second-line"></div>
                    <div class="background-masker content-second-end"></div>
                    <div class="background-masker content-third-line"></div>
                    <div class="background-masker content-third-end"></div>
                </div>
            </div>
            <div class="timeline-item">
                <div class="animated-background">
                    <div class="background-masker content-top"></div>
                    <div class="background-masker content-first-end"></div>
                    <div class="background-masker content-second-line"></div>
                    <div class="background-masker content-second-end"></div>
                    <div class="background-masker content-third-line"></div>
                    <div class="background-masker content-third-end"></div>
                </div>
            </div>
        </div>
            <div class="container product-list hidden">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title text-center mb-20">
                            <h2 class="section-title--one section-title--center">Best Selling</h2>
                        </div>
                    </div>
                </div>

                <div class="product-slider-active">

                    <!-- Single Product Item Start -->
                    <% if(books.length>0) { %>
                      <% for(let i=0; i < books.length; i++) { %>
      
                  
                
      
                 
                    <div class="single-product-item text-center">
                        <div class="products-images">
                            <a href="/productDetails/<%=`${books[i].book_id} `%>" class="product-thumbnail">

                              <% if(books[i].cover_image_url.split(":")[0]=="https") { %>
                                <img  src="<%=`${books[i].cover_image_url}`%>" class="img-fluid bookCoverImage" alt="Product Images"  >
                                <% } else { %>
                                  <img  src="/uploads/<%=`${books[i].cover_image_url}`%>" class="img-fluid bookCoverImage" alt="Product Images"  >
              
                                  <% } %>

                                  <% if (books[i].Inventory.quantity_available <= 0) { %>
                                <span class="ribbon out-of-stock">
                                Out Of Stock
                            </span>
                            <% } %>
                            </a>
                            <div class="product-actions">
                              <a href="/productDetails/<%=`${books[i].book_id} `%>"  data-bs-target="#prodect-modal"><i class="p-icon icon-plus"></i><span class="tool-tip">Quick View</span></a>
                              <% if (books[i].Inventory.quantity_available>0) { %>
                                <a class="add-to-cart"><i class="p-icon icon-bag2 " data-product-id="<%= books[i].book_id %>"></i> <span class="tool-tip">Add to cart</span></a>
                                <% } %>
                            </div>
                        </div>
                        <div class="product-content">
                            <h6 class="prodect-title"><a href="/productDetails/<%=`${books[i].book_id} `%>"><%=books[i].title %></a></h6>
                            <div class="prodect-price">
                                <span class="new-price">$<%=books[i].price %></span>
                            </div>
                        </div>
                    </div><!-- Single Product Item End -->
                    <% } %>
                    <% } %>
                </div>
            </div>
        </div>


       

      

        <div class="our-newsletter-area">
            <div class="container">
                <div class="row">
                    <div class="col-lg-5 col-md-4">
                        <div class="section-title small-mb__40 tablet-mb__40">
                            <h2 class="section-title--one">Our Newsletter</h2>
                        </div>
                    </div>
                    <div class="col-lg-7 col-md-8">
                        <div class="newsletter-wrap">
                            <form action="#" class="newsletter--one">
                                <input class="input-box" name="rememberme" type="text" placeholder="Your email address">
                                <button class="submit-btn">Subscribe</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


























</div>
<%- include('../layout/footer',{companyDetails:companyDetails}) %>


  
   

      
<script src="../assets/js/customerJS/customerCommon.js">
</script>
