<%- include('./partials/pagehead') %>


<%  if (user) { %>
    <%- include('./navBar',{email:user.email,role:user.role,host:host}) %>
<% } %>

<div id="main-wrapper">
  <div class="site-wrapper-reveal border-bottom">

    <div class="my-account-page-warpper section-space--ptb_120">
        <div class="container">

            <div class="row gx-lg-5 align-items-center">
              <div class="col-sm-12 mb-5 mb-lg-12">
                <h1 class="my-5 display-3 fw-bold ls-tight">
                  OTP sent to <br />
                  <span class="text-primary fs-2"><%= email %> </span>
                </h1>
                <p style="color: hsl(217, 10%, 50.8%)">
                 
                </p>
              </div>
            </div>
            <div class="row gx-5 align-items-center">
              <div class="col-md-12 mb-5 mb-lg-12">
                <% if (msg) { %>
                  <div class="alert alert-danger" role="alert">
                        <p><%= msg %>!</p>
                  </div>
                <% } %>
                
              </div>
            </div>
            <div class="row gx-lg-5 align-items-center">
              <div class="col-md-12 mb-5 mb-lg-12">
                <form method="post" action="/<%= admin_route_name %>/verifyOtp" class="account-form-box">
                  <h6>OTP Verification Form</h6>
                  <div class="single-input">
                      <input type="number" placeholder="enter Your OTP" name="OTP">
                  </div>
                  
                  
                  <input type="hidden" name="userId" value="<%= userId %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                  
                  <div class="button-box mt-25">
                      <button type="submit" class="btn btn--full btn--black">Verify OTP Code</button>
                  </div>
                </form>


              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


    
<%- include('./partials/admin_jslibs') %>


</body>

</html>