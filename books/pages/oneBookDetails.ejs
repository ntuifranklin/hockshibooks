<%- include('../../views/partials/pagehead') %>

<%- include('../../views/layout/customerNavBar') %>

<%- include('../../views/partials/breadcrumbs') %>
    


<div id="main-wrapper">
    <div class="site-wrapper-reveal">

        <div class="single-product-wrap section-space--pt_90 border-bottom">
            <div class="book-details loading">
                <div class="book-image animated-background"></div>
                <div class="book-info">
                    <div class="title animated-background"></div>
                    <div class="author animated-background"></div>
                    <div class="price animated-background"></div>
                    <div class="availability animated-background"></div>
                    <div class="isbn animated-background"></div>
                    <div class="description animated-background"></div>
                    <div class="add-to-cart animated-background"></div>
                </div>
            </div>
            <div class="container ">
                <div class="row">
                    <div class="col-lg-7 col-md-6 col-sm-12 col-xs-12">

                        <!-- Product Details Left -->
                        <div class="product-details-left">
                            <div class="product-details-images-2 slider-lg-image-2">

                                <div class="easyzoom-style">
                                    <div class="">
                                        <% if(book.cover_image_url.split(":")[0]=="https") { %>
                                            <a href="<%=`${book.cover_image_url}`%>" class="poppu-img">
                                            <img  src="<%=`${book.cover_image_url}`%>" class="img-fluid product-images" ></a>

                                            <% } else { %>
                                                <a href="/uploads/<%=`${book.cover_image_url}`%>" class="poppu-img">
                                              <img  src="/uploads/<%=`${book.cover_image_url}`%>" class="img-fluid product-images"></a>
                                              
                          
                                              <% } %>
                                       
                                    </div>
                                </div>
                                
                               
                                
                            </div>
                           
                        </div>
                        <!--// Product Details Left -->

                    </div>
                    <div class="col-lg-5 col-md-6 col-sm-12 col-xs-12">
                        <div class="product-details-content ">

                            <h5 class="font-weight--reguler mb-10"><%=book.title%></h5>

                            <h3 class="price">$<%=book.price%></h3>



                            <div class="quickview-peragraph mt-10">
                                <p>By <%=book.author%></p>
                            </div>



                            <div class="product_meta mt-30">
                                <div class="sku_wrapper item_meta">
                                    <span class="label"> ISBN: </span>
                                    <span class="sku"> <%=book.ISBN %> </span>
                                </div>
                               
                               
                            </div>


                            <div class="quickview-action-wrap mt-30">

                                <div>
                                    <span class="font-weight-bold text-dark">Availability:</span>
                                    <%if(book.Inventory.quantity_available>0){ %>
                                        <div class="quickview-cart-box">
                                            <div class="quickview-quality">
                                                <div class="cart-plus-minus">
                                                    <input class="cart-plus-minus-box" type="text" name="qtybutton" value="1" max="5">
                                                </div>
                                            </div>
        
                                            <div class="quickview-button">
                                                <div class="quickview-cart button" onclick="sendToCart(category='books',productIDToUpdate='<%= book.book_id %>', source='', alertIndex='', action='a')">
                                                    <p class="submit add-to-cart btn--lg btn--black font-weight--reguler text-white" data-product-id="<%= book.book_id %>">
                                                        Add to cart
                                                    </p>
                                                </div>
                                                
                                            </div>
                                        </div>
                                    <% } else{ %>
                                        <p  class="btn--lg btn--black font-weight--reguler text-white">Out of Stock</p>

                                    <%}%>
                                </div>
                                

                            </div>

                           
                           

                        </div>
                    </div>
                </div>
               

                <div class="row">
                    <div class="col-12">
                        <div class="product-details-tab section-space--pt_90">
                            <ul role="tablist" class=" nav">
                                <li class="active" role="presentation">
                                    <a data-bs-toggle="tab" role="tab" href="#description" class="active">Description</a>
                                </li>
                                
                            </ul>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="product_details_tab_content tab-content mt-30">
                            <!-- Start Single Content -->
                            <div class="product_tab_content tab-pane active" id="description" role="tabpanel">
                                <div class="product_description_wrap">
                                    <div class="product-details-wrap">
                                        <div class="row align-items-center">
                                            <div class="col-lg-7 order-md-1 order-2">
                                                <div class="details mt-30">
                                                    <h5 class="mb-10">Detail</h5>
                                                    <p> <%=book.description%></p>
                                                </div>
                                            </div>
                                            <div class="col-lg-5 order-md-2 order-1">
                                                <div class="images">
                                                    <img src="assets/images/product/single-product-01.webp" class="img-fluid" alt="">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                           
                        </div>
                    </div>
                </div>

                <div class="related-products section-space--ptb_90">
                    <% if(relatedBooks.length>0) { %>

                    <div class="row">
                        <div class="col-lg-12">
                            <div class="section-title text-center mb-30">
                                <h4>Related products</h4>
                            </div>
                        </div>
                    </div>

                    <div class="product-slider-active">
                            <% for(let i=0; i < relatedBooks.length; i++) { %>   
                          <div class="single-product-item text-center col-lg-12">
                              <div class="products-images">
                                  <a href="/bookss/<%=`${relatedBooks[i].seo_friendly_title} `%>" class="product-thumbnail">
      
                                    <% if(relatedBooks[i].cover_image_url.split(":")[0]=="https") { %>
                                      <img  src="<%=`${relatedBooks[i].cover_image_url}`%>" class="img-fluid" alt="Product Images" width="400" height="400" >
                                      <% } else { %>
                                        <img  src="/uploads/<%=`${relatedBooks[i].cover_image_url}`%>" class="img-fluid" alt="Product Images" width="400" height="400" >
                    
                                    <% } %>
      
                                    <% if (relatedBooks[i].Inventory.quantity_available <= 0) { %>
                                        <span class="ribbon out-of-stock">
                                            Out Of Stock
                                        </span>
                                    <% } %>
                                  </a>
                                  <div class="product-actions">
                                    <a href="/books/<%=`${relatedBooks[i].seo_friendly_title} `%>"  data-bs-target="#prodect-modal"><i class="p-icon icon-plus"></i><span class="tool-tip">Quick View</span></a>
                                    <% if (relatedBooks[i].Inventory.quantity_available>0) { %>
                                      <a class="add-to-cart" onclick="sendToCart(category='books',productIDToUpdate='<%= relatedBooks[i].book_id %>', source='', alertIndex='', action='a')">
                                        <i class="p-icon icon-bag2 " data-product-id="<%= relatedBooks[i].book_id %>"></i> 
                                        <span class="tool-tip">Add to cart</span></a>
                                      <% } %>
                                  </div>
                              </div>
                              <div class="product-content">
                                  <h6 class="prodect-title"><a href="/books/<%=`${relatedBooks[i].seo_friendly_title} `%>"><%=relatedBooks[i].title %></a></h6>
                                  <div class="prodect-price">
                                      <span class="new-price">$<%=relatedBooks[i].price %></span>
                                  </div>
                              </div>
                          </div><!-- Single Product Item End -->
                          <% } %>
                       

                       
                    </div>

                    <% } %>

                </div>

            </div>
        </div>

    </div>


</div>



    <!--====================  scroll top ====================-->
    <a href="#" class="scroll-top" id="scroll-top">
        <i class="arrow-top icon-arrow-up"></i>
        <i class="arrow-bottom icon-arrow-up"></i>
    </a>
    
    <%- include('../../views/partials/commonjslibs'); %>

    <%- include('../../cart/pages/partials/post_product_to_update_cart_js.ejs') %>
</body>
</html>