
<% if(typeof books != 'undefined' && typeof books.length != 'undefined' && books.length>0) { %>
    <% for (let i=0; i < books.length; i++) { %>
        
        <% //if loading open api image, then we can load the large format. %>
        <% //else if loading local image we load medium format to save data transfer %>
        <% let anchorBookCoverUrl ; %>
        <% let imgSrcCoverUrl ; %> 
        <% let book = books[i]; %>
        <% let stringCoverUrl = book.cover_image_url ; %>                                                      

        <% if(stringCoverUrl.split(":")[0].startsWith("http")) { %>

            <%  anchorBookCoverUrl = book.cover_image_url_large;%>
            <%  imgSrcCoverUrl = book.cover_image_url_large ;%> 

        <% } else { %>
            
            <%  anchorBookCoverUrl = `/uploads/${book.cover_image_url_medium}`;%>
            <%  imgSrcCoverUrl = `/uploads/${book.cover_image_url_medium}` ;%>                                                     

        <% } %>        
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="single-product-item text-center">
                <div class="products-images">
                    <a href="/<%= base_route_name %>/<%= books[i].seo_friendly_title %>" class="product-thumbnail">
                    <%
                        /*
                        large open library image dimensions
                        width="311" height="475"
                        
                        */
                    %>
                    <img  src="<%= imgSrcCoverUrl %>" class="img-fluid" alt="<%= book.seo_friendly_title %>" width="311" height="475">
    
                    <% if (book.Inventory == null || !("quantity_available" in book.Inventory) ||  book.Inventory.quantity_available <= 0) { %>
                        <span class="ribbon out-of-stock">
                        Out Of Stock
                        </span>
                    <% } %>
                    </a>
                    <div class="product-actions">
                    <a href="/<%= base_route_name %>/<%= book.seo_friendly_title %>"  data-bs-target="#prodect-modal">
                        <i class="p-icon icon-plus"></i>
                        <span class="tool-tip">Quick View</span>
                    </a>
                    <% if (book.Inventory != null && "quantity_available" in book.Inventory && book.Inventory.quantity_available>0) { %>
                    <a class="add-to-cart" onclick="sendToCart(category='books',productIDToUpdate='<%= book.book_id %>', source='', alertIndex='', action='a')">
                        <i class="p-icon icon-bag2 " data-product-id="<%= book.book_id %>"></i> 
                        <span class="tool-tip">Add to cart</span></a>
                    <% } %>
                    </div>
                </div>
                <div class="product-content">
                    <h6 class="prodect-title"><a href="/<%= base_route_name %>/<%= book.seo_friendly_title %>"><%=book.title %></a></h6>
                    <div class="prodect-price">
                        <span class="new-price">$<%=book.price %></span>
                    </div>
                </div>
            </div>
        </div>         
       
        <!-- Single Product Item End -->
    <% } %>
<% } else { %>
    <div class="col-lg-12">
        <div class="alert alert-warning" role="alert">
            No books found
        </div>
    </div>
<% } %>       