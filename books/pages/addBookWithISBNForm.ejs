<%- include('./partials/pagehead') %>
<%- include('../../admin/pages/navBar') %>
<%- include('../../views/partials/breadcrumbs') %>
    <div class="container">
       
    <div class="errors">
        <% if (msg) { %>
        <div class="alert alert-danger alert-dismissible fade" data-bs-dismiss="alert" role="alert">
            <p><%= msg.msg %>!</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% } %>

    </div>

    <div id="main-wrapper">
        <div class="site-wrapper-reveal border-bottom">

            <div class="my-account-page-warpper section-space--ptb_120">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-4 col-md-8 col-sm-12 col-xs-12 m-auto w-50">
                            <div class="myaccount-box-wrapper">
                                
                                <div class="tab-content content-modal-box">
                                    <div class="tab-pane fade show active" id="tab_list_06" role="tabpanel">
                                        <% let post_add_book_with_isbn_route = books_route_name + '/' + add_books_route_name %>
                                        <form method="post" action="/<%= post_add_book_with_isbn_route %>">
                                            <h1>Add Book With ISBN</h1>
                                            <div class="single-input">
                                                <label for="isbn" class="w-100">ISBN: 

                                                <input type="text"  class="form-control" id="isbn" placeholder="The ISBN can be 10 or 13 caracters long" name="isbn">

                                                </label>
                                            </div>
                                            <div class="single-input">                                                
                                                    <label for="displayName" class="w-100">price:
                                                        <input type="number" step=".01"  name="price" value=25.00 class="form-control" id="displayName" placeholder="$25 is the default price">
                                                    </label>                                                
                                            </div>
                                            
                                            <div class="single-input">
                                                <label for="qty" class="w-100">Quantity: 
                                                    <input type="number" name="qty" value=1 class="form-control" id="qty" placeholder="The number of books">
                                                </label>
                                            </div>
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            
                                            <div class="button-box mt-25">
                                                <button type="submit" class="btn btn--full btn--black">Save updates</button>
                                            </div>
                                        </form>
                                    </div>
                                    

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <%- include('../../views/partials/footerarea') %>
</div>


<%- include('../../admin/pages/partials/adminMobileMenuOverlay') %>

  <!--====================  scroll top ====================-->
  <a href="#" class="scroll-top" id="scroll-top">
    <i class="arrow-top icon-arrow-up"></i>
    <i class="arrow-bottom icon-arrow-up"></i>
  </a>
    
<%- include('../../admin/pages/partials/admin_jslibs') %>



</body>

</html>
</body>
</html>

