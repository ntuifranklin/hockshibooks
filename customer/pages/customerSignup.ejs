<%- include('../../views/partials/pagehead') %>

<%- include('../../views/layout/customerNavBar') %>

<%- include('../../views/partials/breadcrumbs') %>



   
<div id="main-wrapper">
    <div class="site-wrapper-reveal border-bottom">

        <div class="my-account-page-warpper section-space--ptb_120">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 col-md-7 m-auto">
                        <div class="myaccount-box-wrapper">
                            <div class="helendo-tabs">
                                <ul class="nav" role="tablist">
                                    <li class="tab__item nav-item active">
                                        <a class="nav-link active" data-bs-toggle="tab" href="#tab_list_07" role="tab">Our Register</a>
                                    </li>
                                    <li class="tab__item nav-item">
                                        <a class="nav-link" data-bs-toggle="tab" href="#tab_list_06" role="tab">Login</a>
                                    </li>
                                </ul>
                            </div>
                            <% if (msg) { %>
                                <div class="alert alert-danger" role="alert">
                                    <p><%= msg %>!</p>
                                </div>
                            <% } %>

                            <% if (errors) { %>
                                <div class="errors">
                                    <% for(let i=0; i < errors.length; i++) { %>                                                           
                                        
                                        <div class="alert alert-danger" role="alert">
                                            <p><%= errors[i].msg %>!</p>
                                        </div>
                                    <% } %>
                                                                                                           
                                </div>
                            <% } else if (sucessmsg) { %>
                                    <div class="alert alert-success" role="alert">
                                        <p><%= sucessmsg %></p>
                                    </div>  
                            <% } %>
                            <div class="tab-content content-modal-box">
                                
                                <div class="tab-pane fade show active" id="tab_list_07" role="tabpanel">
                                    
                                    <form method="POST" action="/customer/signup" class="account-form-box">
                                        <h6>Register An Account</h6>

                                        <div class="form-row">
                                            <div class="form-group single-input">
                                                <input type="text"  id="firstName" placeholder="First Name" name="first_name">
                                            </div>
                                            <div class="form-group single-input">
                                                <input type="text"  id="lastName" placeholder="Last Name" name="last_name">
                                            </div>
                                        </div>
                                        <div class="single-input">
                                            <input type="number"  id="phoneNumber" placeholder="Phone Number" name="phone">
                                        </div>
                                        <div class="single-input">
                                            <input type="email"  id="email" placeholder="Email" name="email">

                                        </div>
                                        <div class="single-input">
                                            <input type="password"  id="password" placeholder="Password" name="password">

                                        </div>
                                        <div class="single-input">
                                            <select name="state_province" id="state_province">
                                                <option selected="false">states</option>
                                                <% for(let i=0; i < states.length; i++) { %>
                                                    
                                                    <option value="<%= states[i].province_state_id %>"><%= states[i].country_code %>-<%= states[i].province_state_name %></option> 
                                                <% } %>
                                        </select>
                                        </div>
                                        <div class="single-input">
                                            <input type="text"  id="street_address" placeholder="street address" name="street_address">

                                        </div>
                                        <div class="single-input">
                                            <input type="text"  id="email" placeholder="city" name="city">
                                        </div>
                                        <div class="single-input">
                                            <input type="text"  id="postal_zipcode" placeholder="postal zipcode" name="postal_zipcode">
                                        </div>
                                    

                                        <input type="hidden" name="_csrf"
                                        value="<%= csrfToken %>">
                                        <p class="mt-15">Your personal data will be used to support your experience throughout this website, 
                                            to manage access to your account, and for other purposes described in our 
                                            <a href="/docs/policy" class="privacy-policy-link" target="_blank">privacy policy</a>.</p>
                                        <div class="button-box mt-25">
                                            <button type="submit" class="btn btn--full btn--black">Register</button>
                                        </div>
                                    </form>
                                </div>
                                <div class="tab-pane fade" id="tab_list_06" role="tabpanel">
                                    
                                    <form method="post" action="/customer/login" class="account-form-box">
                                        <h6>Login your account</h6>
                                        <div class="single-input">
                                            <input type="text" placeholder="Email" name="email">
                                        </div>
                                        <div class="single-input">
                                            <input type="password" placeholder="Password" name="password">
                                        </div>
                                        <!-- <div class="checkbox-wrap mt-10">
                                            <label class="label-for-checkbox inline mt-15">
                                                <input class="input-checkbox" name="rememberme" type="checkbox" id="rememberme" value="forever"> <span>Remember me</span>
                                            </label>
                                            <a href="#" class=" mt-10">Lost your password?</a>
                                        </div> -->

                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <div class="button-box mt-25">
                                            <button type="submit" class="btn btn--full btn--black">Log in</button>
                                        </div>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('../../views/partials/footerarea') %>
  
</div>





    <!--====================  scroll top ====================-->
    <a href="#" class="scroll-top" id="scroll-top">
        <i class="arrow-top icon-arrow-up"></i>
        <i class="arrow-bottom icon-arrow-up"></i>
    </a>
    
<%- include('../../views/partials/commonjslibs'); %>

</body>

</html>