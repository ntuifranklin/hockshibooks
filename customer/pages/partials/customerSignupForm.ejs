
<form method="POST" action="/customer/signup" class="account-form-box">
    <h6>Register An Account</h6>

    <div class="form-row">
        <div class="form-group single-input">
            <input type="text"  id="firstName" placeholder="First Name" name="first_name">
        </div>
        <div class="form-group single-input">
            <input type="text"  id="lastName" placeholder="Last Name" name="last_name">
        </div>
    </div>
    <div class="single-input">
        <input type="number"  id="phoneNumber" placeholder="Phone Number" name="phone">
    </div>
    <div class="single-input">
        <input type="email"  id="email" placeholder="Email" name="email">

    </div>
    <div class="single-input">
        <input type="password"  id="password" placeholder="Password" name="password">

    </div>
    <div class="single-input">
        <select name="state_province_id" id="state_province_id">
            <option selected="false">States</option>
            <% for(let i=0; i < states.length; i++) { %>                
                <option value="<%= states[i].province_state_id %>"><%= states[i].country_code %>-<%= states[i].province_state_name %></option> 
            <% } %>
    </select>
    </div>
    <div class="single-input">
        <input type="text"  id="street_address" placeholder="street address" name="street_address">

    </div>
    <div class="single-input">
        <input type="text"  id="email" placeholder="city" name="city">
    </div>
    <div class="single-input">
        <input type="text"  id="postal_zipcode" placeholder="postal zipcode" name="postal_zipcode">
    </div>


    <input type="hidden" name="_csrf"
    value="<%= csrfToken %>">
    <p class="mt-15">Your personal data will be used to support your experience throughout this website, 
        to manage access to your account, and for other purposes described in our 
        <a href="/docs/policy" class="privacy-policy-link" target="_blank">privacy policy</a>.</p>
    <div class="button-box mt-25">
        <button type="submit" class="btn btn--full btn--black">Register</button>
    </div>
</form>