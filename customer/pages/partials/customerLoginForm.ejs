
<form method="post" action="/customer/login" class="account-form-box">
    <h6>Login your account</h6>
    <div class="single-input">
        <input type="text" placeholder="Email" name="email">
    </div>
    <div class="single-input">
        <input type="password" placeholder="Password" name="password">
    </div>
    
    <div class="checkbox-wrap mt-10">
        <a href="/customer/showForm" class=" mt-10">Guest User ?</a>
    </div>
    <div class="checkbox-wrap mt-10">
        <a href="/customer/resetPassword" class=" mt-10">Lost your password?</a>
    </div>

    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="button-box mt-25">
        <button type="submit" class="btn btn--full btn--black">Log in</button>
    </div>
</form>